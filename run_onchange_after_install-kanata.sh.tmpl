#!/bin/bash
# Installs kanata, the Karabiner VirtualHIDDevice driver it outputs through,
# and root LaunchDaemons for both. Rerun by chezmoi when the config or a
# pinned version changes. Upgrade kanata and the driver together: each kanata
# release supports exactly one driver version.
# kanata.kbd hash: {{ include "dot_config/kanata/kanata.kbd" | sha256sum }}
set -euo pipefail

kanata_version=1.12.0
if [ "$(uname -m)" = arm64 ]; then
  kanata_arch=arm64
  kanata_sha=839769d189911b5881e11550eaa2039705213fb725865d088f5a2e3a6c10de32
else
  kanata_arch=x64
  kanata_sha=bdb8b2f7ae2a648336a2561c7c6c00a736cd76e012035df651114b304c5ffb01
fi
driver_version=6.2.0
driver_sha=9e8c46239f0748161241e42444857901224e5c82f5b58a1731df4c70bf0736a8

config_src="{{ .chezmoi.sourceDir }}/dot_config/kanata/kanata.kbd"
manager=/Applications/.Karabiner-VirtualHIDDevice-Manager.app/Contents/MacOS/Karabiner-VirtualHIDDevice-Manager
vhid_daemon="/Library/Application Support/org.pqrs/Karabiner-DriverKit-VirtualHIDDevice/Applications/Karabiner-VirtualHIDDevice-Daemon.app/Contents/MacOS/Karabiner-VirtualHIDDevice-Daemon"

if [ -d /Applications/Karabiner-Elements.app ]; then
  echo "kanata: Karabiner-Elements is still installed and would fight kanata for the keyboard; run 'brew bundle cleanup --force --file=~/.Brewfile'" >&2
  exit 1
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# download URL SHA256 FILE
download() {
  curl -fsSL "$1" -o "$3"
  echo "$2  $3" | shasum -a 256 -c - >/dev/null
}

installed_driver=$(defaults read "${manager%/MacOS/*}/Info" CFBundleShortVersionString 2>/dev/null || true)
if [ "$installed_driver" != "$driver_version" ]; then
  echo "kanata: installing Karabiner VirtualHIDDevice driver $driver_version (have: ${installed_driver:-none})"
  download "https://github.com/pqrs-org/Karabiner-DriverKit-VirtualHIDDevice/releases/download/v$driver_version/Karabiner-DriverKit-VirtualHIDDevice-$driver_version.pkg" \
    "$driver_sha" "$tmp/driver.pkg"
  sudo installer -pkg "$tmp/driver.pkg" -target /
  sudo "$manager" forceActivate
fi

if [ "$(/usr/local/bin/kanata --version 2>/dev/null)" != "kanata $kanata_version" ]; then
  echo "kanata: installing kanata $kanata_version"
  download "https://github.com/jtroo/kanata/releases/download/v$kanata_version/macos-binaries-$kanata_arch.zip" \
    "$kanata_sha" "$tmp/kanata.zip"
  unzip -q "$tmp/kanata.zip" -d "$tmp/kanata"
  # The cmd_allowed build is needed for the macism calls in the config.
  # Root-owned, since a root daemon runs it.
  sudo install -d -o root -g wheel /usr/local/bin
  sudo install -o root -g wheel -m 755 "$tmp/kanata/kanata_macos_cmd_allowed_$kanata_arch" /usr/local/bin/kanata
fi

# The daemon reads a root-owned copy: the config can run commands as root
# through cmd, so it must not be writable by the user.
/usr/local/bin/kanata --check --cfg "$config_src" >/dev/null
sudo install -d -o root -g wheel /etc/kanata
sudo install -o root -g wheel -m 644 "$config_src" /etc/kanata/kanata.kbd

# install_daemon LABEL KEEPALIVE PROGRAM [ARGS...]
install_daemon() {
  local label=$1 keepalive=$2 plist="/Library/LaunchDaemons/$1.plist" args=""
  shift 2
  for arg in "$@"; do args+="<string>$arg</string>"; done
  sudo tee "$plist" >/dev/null <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array>$args</array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>$keepalive
  <key>StandardOutPath</key><string>/var/log/$label.log</string>
  <key>StandardErrorPath</key><string>/var/log/$label.log</string>
</dict>
</plist>
EOF
  sudo chown root:wheel "$plist"
  sudo chmod 644 "$plist"
  if sudo launchctl print "system/$label" >/dev/null 2>&1; then
    sudo launchctl bootout "system/$label" || true
  fi
  # bootstrap right after bootout can fail while the old job is still exiting
  for _ in 1 2 3 4 5; do
    sudo launchctl bootstrap system "$plist" 2>/dev/null && return
    sleep 1
  done
  sudo launchctl bootstrap system "$plist"
}

install_daemon org.pqrs.Karabiner-VirtualHIDDevice-Daemon "<true/>" "$vhid_daemon"
install_daemon dev.kanata.kanata "<dict><key>SuccessfulExit</key><false/></dict>" \
  /usr/local/bin/kanata --cfg /etc/kanata/kanata.kbd

echo "kanata: if keys don't remap, allow /usr/local/bin/kanata in System Settings > Privacy & Security > Input Monitoring and Accessibility (log: /var/log/dev.kanata.kanata.log), then: sudo launchctl kickstart -k system/dev.kanata.kanata"

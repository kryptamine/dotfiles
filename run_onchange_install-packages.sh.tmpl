#!/bin/bash

# Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}

if ! command -v brew >/dev/null; then
  echo "brew not found, skipping brew bundle. Install Homebrew: https://brew.sh" >&2
  exit 0
fi

brew bundle --file="$HOME/.Brewfile"
# Uninstall anything not listed, so every machine ends up with the same set.
brew bundle cleanup --force --file="$HOME/.Brewfile"

#!/bin/sh
# Refuse to push a commit that is not signed by a key this machine trusts.
# Only commits no remote has yet are checked. Bypass: git push --no-verify.

remote="$1"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0

while read -r local_ref local_sha _ remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # branch deletion
	# A remote tip missing locally (a force push) falls back to every remote
	if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
		range="$local_sha --not --remotes=$remote"
	else
		range="$remote_sha..$local_sha"
	fi
	# shellcheck disable=SC2086
	if ! shas=$(git rev-list $range); then
		echo "pre-push: cannot list commits for $local_ref" >&2
		status=1
		continue
	fi
	for sha in $shas; do
		case $(git log -1 --format=%G? "$sha") in
		G) ;;
		*)
			echo "pre-push: unsigned or unverified commit in $local_ref:" >&2
			git log -1 --format='  %h %G? %s' "$sha" >&2
			status=1
			;;
		esac
	done
done

[ "$status" -eq 0 ] || echo "pre-push: sign with git commit --amend -S, or git rebase --exec 'git commit --amend --no-edit -S'" >&2
exit "$status"

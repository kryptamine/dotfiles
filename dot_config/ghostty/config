# Ghostty config

# ── Shell / integration ───────────────────────────────────────────────
# No `command` here on purpose: fish is already the login shell, so Ghostty
# picks it up from $SHELL / passwd without hardcoding the Homebrew prefix.
# Autostart the herdr workspace manager, but only in the window Ghostty
# opens on launch — cmd+T / cmd+N still give a plain fish shell.
initial-command = /opt/homebrew/bin/herdr
shell-integration = fish
# `no-title` is deliberately absent: Ghostty has no tab title template, so the
# shell has to be the one setting window/tab titles.
shell-integration-features = no-cursor,sudo

font-family = Iosevka Term
font-style-italic = false
font-style-bold-italic = false
font-size = 21
font-thicken = false
font-synthetic-style = no-bold
font-feature = zero
font-feature = dlig
adjust-cell-height = 10%
adjust-icon-height = -50%
adjust-box-thickness = 1
adjust-underline-thickness = 1
adjust-underline-position = 2
adjust-cursor-thickness = 2

theme = gruber-darker-renaissance
alpha-blending = linear-corrected
minimum-contrast = 1.1

cursor-style = block
cursor-style-blink = false
macos-titlebar-style = hidden
macos-option-as-alt = true
window-colorspace = display-p3
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-padding-color = extend
window-save-state = always
quit-after-last-window-closed = true
resize-overlay = never

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

auto-update = download


# Ghostty config — ported from ~/.config/kitty/kitty.conf

# ── Shell / integration ───────────────────────────────────────────────
# No `command` here on purpose: fish is already the login shell, so Ghostty
# picks it up from $SHELL / passwd without hardcoding the Homebrew prefix.
# Autostart the herdr workspace manager, but only in the window Ghostty
# opens on launch — cmd+T / cmd+N still give a plain fish shell.
initial-command = /opt/homebrew/bin/herdr
shell-integration = fish
# `no-title` is deliberately absent: without kitty's tab_title_template the
# shell has to be the one setting window/tab titles.
shell-integration-features = no-cursor,sudo

font-family = IosevkaTerm Nerd Font Mono
font-size = 22

theme = gruber-darker
alpha-blending = linear-corrected

cursor-style = block
macos-titlebar-style = hidden
macos-option-as-alt = true
window-colorspace = display-p3
window-padding-balance = true
window-save-state = always
quit-after-last-window-closed = true
resize-overlay = never

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

auto-update = download


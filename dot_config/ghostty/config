# Ghostty config

# ── Shell / integration ───────────────────────────────────────────────
# No `command` here on purpose: fish is already the login shell, so Ghostty
# picks it up from $SHELL / passwd without hardcoding the Homebrew prefix.
# Autostart the herdr workspace manager, but only in the window Ghostty
# opens on launch — cmd+T / cmd+N still give a plain fish shell.
initial-command = /opt/homebrew/bin/herdr
# herdr starts outside fish, so without these its edit_scrollback falls back to vi.
# Absolute, since that PATH lacks /opt/homebrew/bin.
env = EDITOR=/opt/homebrew/bin/nvim
env = VISUAL=/opt/homebrew/bin/nvim
shell-integration = fish
# `no-title` is deliberately absent: Ghostty has no tab title template, so the
# shell has to be the one setting window/tab titles.
shell-integration-features = no-cursor,sudo

# Monaspace Neon: texture healing (calt) evens out the spacing of narrow and
# wide letters. Monaspace Argon is the humanist sibling, a one-word swap.
font-family = Monaspace Neon
font-style = Regular
font-style-italic = false
# No bold face anywhere: tools that still ask for bold (lazygit borders,
# fish pager, gh, brew) get regular, like everything themed in the palette
font-style-bold = false
font-style-bold-italic = false
font-size = 22
# macOS font smoothing is off (see run_onchange_macos-defaults.sh), which
# leaves fonts thin on Retina; a light thicken brings the weight back
font-thicken = true
font-thicken-strength = 40
font-synthetic-style = no-bold
# Slashed zero (Monaspace's default is dotted)
font-feature = cv01=2
# Ligatures, which JetBrains Mono had on by default: = ! < > - | : . # and tags.
# calt (texture healing) is on by default.
font-feature = liga,ss01,ss02,ss03,ss04,ss05,ss06,ss07,ss08,ss09,ss10
# Keep ligatures intact under the cursor
font-shaping-break = no-cursor
# A little air between lines
adjust-cell-height = 10%
adjust-box-thickness = 1
adjust-underline-thickness = 1
adjust-underline-position = 2
adjust-cursor-thickness = 2

theme = gruber-darker-renaissance
alpha-blending = linear-corrected
minimum-contrast = 1.1

cursor-style = block
cursor-style-blink = false
macos-titlebar-style = hidden
# No native frame: the only way to get squared window corners
window-decoration = none
# The shadow outlives the frame and draws a halo around the borderless window
macos-window-shadow = false
macos-option-as-alt = true
window-colorspace = display-p3
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-padding-color = extend
window-save-state = always
quit-after-last-window-closed = true
resize-overlay = never
# Dim the split that doesn't have focus
unfocused-split-opacity = 0.85
unfocused-split-fill = #000000
split-divider-color = #3a3a3a
# The stock search highlight is off-palette
search-foreground = #000000
search-background = #efd45b
search-selected-foreground = #000000
search-selected-background = #cc8c3c

# Dock icon in the palette: black screen, yellow ghost
macos-icon = custom-style
macos-icon-frame = chrome
macos-icon-ghost-color = #efd45b
macos-icon-screen-color = #000000,#1e1e1e

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

auto-update = download


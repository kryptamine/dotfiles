# Editor
set -gx EDITOR nvim
set -gx VISUAL nvim

# fzf: fzf.fish's own defaults plus the gruber-darker-renaissance palette.
# Pointer and marker are the same bar gitsigns draws in nvim.
# fzf-lua inherits this too, but passes its own --border, --height and colors.
set -gx FZF_DEFAULT_OPTS (string join ' ' -- \
    --cycle --layout=reverse --border=sharp --height=90% --info=inline-right \
    --preview-window=wrap '--pointer=▌' '--marker=▌' \
    --color=fg:#d2d2cc,bg:-1,hl:#efd45b,fg+:#ebebe6,bg+:#1e1e1e,hl+:#efd45b \
    --color=info:#8c8c8c,prompt:#efd45b,pointer:#efd45b,marker:#8ac568 \
    --color=spinner:#9e95c7,header:#9fb2d6,border:#555555,label:#8c8c8c \
    --color=gutter:-1,separator:#555555,scrollbar:#555555,query:#d2d2cc)

# eza: colors come from theme.yml there. On macOS eza looks in
# ~/Library/Application Support, not ~/.config, unless told where to look
set -gx EZA_CONFIG_DIR ~/.config/eza

# fzf.fish previews: directories through eza (theme.yml colors and icons),
# diffs in git status/log search through delta (gitconfig colors)
set -gx fzf_preview_dir_cmd eza --all --color=always --icons=always --group-directories-first
set -gx fzf_diff_highlighter delta --paging=never --width=20

# ripgrep colors live in a config file it only reads when pointed at it
set -gx RIPGREP_CONFIG_PATH ~/.config/ripgrep/config

# jq colors from the palette, matching nvim's JSON highlighting: null ash,
# booleans yellow (keyword), numbers quartz, strings green, punctuation gray,
# keys fg1 (@property). Order: null:false:true:numbers:strings:arrays:objects:keys
set -gx JQ_COLORS (string join : -- \
    '38;2;110;106;100' '38;2;239;212;91' '38;2;239;212;91' '38;2;150;162;156' \
    '38;2;138;197;104' '38;2;140;140;140' '38;2;140;140;140' '38;2;235;235;230')

# less (the pager behind delta, git and gh): git's own -FRX defaults, which it
# only adds when LESS is unset, plus palette colors for search matches (black
# on yellow, like ghostty's search), errors and the status line. -X is dropped:
# less 530+ quits on short output without it, and it breaks wheel scrolling
set -gx LESS -FR --use-color -DSky -DEkr -DPy

# Markdown in gh (pr/issue view) and other glamour-based tools: the stock
# dark style recolored with the palette
set -gx GLAMOUR_STYLE ~/.config/glamour/gruber-darker-renaissance.json

# man pages through bat, which takes the terminal palette (see bat/config)
set -gx MANPAGER "sh -c 'col -bx | bat -l man -p'"
set -gx MANROFFOPT -c

# Homebrew (Apple Silicon): what `brew shellenv fish` prints, inlined because
# running it costs 20-30 ms on every shell start
set -gx HOMEBREW_PREFIX /opt/homebrew
set -gx HOMEBREW_CELLAR /opt/homebrew/Cellar
set -gx HOMEBREW_REPOSITORY /opt/homebrew
fish_add_path -g -m -P /opt/homebrew/bin /opt/homebrew/sbin
if test -n "$MANPATH"
    set -gx MANPATH (string replace -r '^:*(.*?):*$' ':$1' -- "$MANPATH")
end
set -q INFOPATH; or set INFOPATH ''
contains /opt/homebrew/share/info $INFOPATH
or set -gx INFOPATH /opt/homebrew/share/info $INFOPATH

# Base PATH additions (earlier = higher priority). fish_add_path skips
# directories that don't exist, so machine-specific ones are safe here.
# ~/.local/bin: Antigravity CLI, Hermes Agent
fish_add_path -g \
    ~/.local/bin \
    ~/.cargo/bin \
    ~/.grok/bin \
    ~/.yarn/bin \
    ~/.local/share/nvim/mason/bin

# Source a script cached in ~/.cache/fish/<name>.fish, regenerated by running
# the rest of argv when the key changes. Keys hold a resolved binary path (a
# brew upgrade moves it to a new Cellar version) or a source file's mtime
function _source_cached -a name key
    set -l cache ~/.cache/fish/$name.fish
    if not test -f $cache; or test (head -n1 $cache) != "# $key"
        mkdir -p (path dirname $cache)
        begin
            echo "# $key"
            $argv[3..]
        end >$cache
        # Don't keep a half-written cache around
        or begin
            rm -f $cache
            return 1
        end
    end
    source $cache
end

# LS_COLORS for fd, tree and others, from vivid/themes (mirrors eza's theme).
# After the Homebrew PATH setup, which is where vivid lives
function _ls_colors_script
    echo set -gx LS_COLORS (vivid generate gruber-darker-renaissance 2>/dev/null | string escape)
end
if command -q vivid
    _source_cached ls-colors \
        (path resolve (command -s vivid))" "(path mtime ~/.config/vivid/themes/gruber-darker-renaissance.yml) \
        _ls_colors_script
end

# Go
set -gx GOPATH $HOME/go
fish_add_path -g $GOPATH/bin

# Disable fish greeting
set -g fish_greeting

# Theme: generated from the gruber-darker-renaissance palette. Applying it
# parses the theme file on every start, so the resulting variables are cached
function _theme_script
    fish_config theme choose gruber-darker-renaissance
    for var in (__fish_theme_variables)
        echo set -g $var (string escape -- $$var)
    end
end

# `<tool> init fish`, cached per binary
function _tool_init_script -a bin
    $bin init fish $argv[2..]
end

if status is-interactive
    _source_cached theme \
        "$version "(path mtime ~/.config/fish/themes/gruber-darker-renaissance.theme) \
        _theme_script
    for tool in starship zoxide
        set -l bin (command -s $tool); or continue
        # zoxide: z <dir>, zi for fzf picker
        set -l flags
        test $tool = starship; and set flags --print-full-init
        _source_cached $tool-init (path resolve $bin) _tool_init_script $bin $flags
    end
end
functions -e _source_cached _ls_colors_script _theme_script _tool_init_script

# pnpm
set -gx PNPM_HOME "$HOME/Library/pnpm"
fish_add_path -g $PNPM_HOME/bin

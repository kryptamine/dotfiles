[user]
	name = {{ .name }}
	email = {{ .email }}
	signingkey = {{ .signingkey }}
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[core]
	pager = diff-so-fancy | less --tabs=4 -RF
[interactive]
	diffFilter = diff-so-fancy --patch
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
	followTags = true
[pull]
	rebase = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	updateRefs = true
[branch]
	sort = -committerdate
[rerere]
	enabled = true
[diff]
	algorithm = histogram
	mnemonicPrefix = true
	colorMoved = default
[merge]
	conflictStyle = zdiff3
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
	verbose = true
[tag]
	gpgsign = true
	sort = version:refname
[help]
	autocorrect = prompt
[column]
	ui = auto
# Colors from the gruber-darker-renaissance palette; diff-so-fancy reads them too
[color "diff"]
	meta = "#efd45b"
	frag = "#9e95c7"
	func = "#8c8c8c"
	commit = "#efd45b"
	old = "#d64c4b"
	new = "#8ac568"
	whitespace = "#d64c4b" reverse
[color "diff-highlight"]
	oldNormal = "#d64c4b"
	oldHighlight = "#f26063" "#3a1616"
	newNormal = "#8ac568"
	newHighlight = "#a6e384" "#1c3314"
[color "status"]
	added = "#8ac568"
	changed = "#d64c4b"
	untracked = "#cc8c3c"
	branch = "#efd45b"
